@page "/presidentes/{Slug}"
@inject QueryService Queries

@if (Missing)
{
    <Seo Title="Presidente não encontrado" Description="Não há presidente publicado neste endereço." Path="@($"/presidentes/{Slug}")" />
    <section class="section"><div class="wrap"><h1>Presidente não encontrado</h1><p>Não há registro publicado neste endereço.</p></div></section>
}
else if (Item is not null)
{
    <Seo Title="@Item.FullName" Description="@Meta" Path="@($"/presidentes/{Item.Slug}")" OpenGraphType="profile" JsonLd="@JsonLd" />
    <section class="section">
        <div class="wrap">
            @if (Item.Demonstration)
            {
                <p class="banner">Registro de demonstração. O texto reúne apenas o que está ligado às fontes cadastradas e não esgota o mandato.</p>
            }
            <div class="profile">
                <div class="portrait">
                    @if (!string.IsNullOrWhiteSpace(Item.PhotoUrl))
                    {
                        <img src="@Item.PhotoUrl" alt="@($"Retrato de {Item.FullName}")" />
                    }
                    else
                    {
                        <span>@Ui.Initials(Item.Name)</span>
                    }
                </div>
                <div>
                    <h1>@Item.FullName</h1>
                    <p>@Item.Mandate</p>
                    <p>@Item.PartyCaption: @(Item.Party ?? "não informado")</p>
                    <p>Vice-presidente: @(Item.VicePresident ?? "não informado")</p>
                    <p class="muted">Nascimento: @Ui.Date(Item.BirthDate) · Falecimento: @Ui.Date(Item.DeathDate) · Origem do cadastro: @Item.Provenance</p>
                </div>
            </div>
            <nav class="anchor-nav" aria-label="Seções do presidente">
                <a href="#leis">Leis</a>
                <a href="#temas">Temas</a>
                <a href="#indicadores">Indicadores do período</a>
                <a href="#mandatos">Mandatos</a>
                <a href="#fontes">Fontes</a>
            </nav>

            <section id="leis">
                <h2>Leis assinadas no período</h2>
                <p class="muted">@Item.LawTotal.ToString("N0") normas publicadas com data de assinatura a partir de 15/03/1985 e presidente em exercício neste registro. A amostra abaixo traz as mais recentes. A assinatura não atribui autoria.</p>
                <p><a href="@($"/leis?presidente={Item.Id}&de=1985-03-15")">Abrir a lista completa</a></p>
                @if (Item.Laws.Count == 0)
                {
                    <p class="empty">Nenhuma lei publicada está vinculada a este presidente.</p>
                }
                @foreach (var law in Item.Laws)
                {
                    <article class="card">
                        <p><span class="badge">@law.Kind</span> <span class="badge">@law.Number/@law.Year</span> <span class="badge">@Ui.Date(law.SanctionDate)</span></p>
                        <h3><a href="@($"/leis/{law.Slug}")">@law.Title</a></h3>
                        <p>@(law.Summary is { Length: > 280 } ? law.Summary[..277].TrimEnd() + "…" : law.Summary)</p>
                        <p class="muted">@(law.Categories.Count > 0 ? string.Join(", ", law.Categories) : "Tema não identificado")</p>
                    </article>
                }
            </section>

            <section id="temas">
                <h2>Temas das leis</h2>
                <div class="grid cards-4">
                    @foreach (var topic in Item.LawTopics)
                    {
                        <a class="card" href="@($"/leis?presidente={Item.Id}&categoria={topic.Id}&de=1985-03-15")">
                            <p class="topic-count">@topic.LawCount.ToString("N0")</p>
                            <strong>@topic.Name</strong>
                        </a>
                    }
                </div>
                @if (Item.LawTopics.Count == 0)
                {
                    <p class="empty">Nenhuma lei deste presidente recebeu tema.</p>
                }
            </section>

            <section id="indicadores">
                <h2>Indicadores do período</h2>
                <p>@PeriodMetrics.Disclaimer</p>
                @if (Item.PeriodMetrics.Count == 0)
                {
                    <p class="empty">Não há observação de IPCA, PIB, salário mínimo ou desocupação com início dentro dos mandatos publicados.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Mandato</th><th>Indicador</th><th>Variação no período</th><th>Fonte</th></tr></thead>
                            <tbody>
                                @foreach (var row in Item.PeriodMetrics)
                                {
                                    <tr>
                                        <td>@row.MandateLabel</td>
                                        <td>@row.Indicator</td>
                                        <td>@row.Text</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(row.SourceUrl))
                                            {
                                                <a href="@row.SourceUrl" rel="noopener noreferrer">@row.SourceName</a>
                                            }
                                            else
                                            {
                                                @row.SourceName
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section id="mandatos">
                <h2>Mandatos e registro biográfico</h2>
                <h3>Biografia</h3>
                <p>@(Item.Biography ?? "Não há biografia publicada.")</p>
                <h3>Contexto histórico</h3>
                <p>@(Item.HistoricalContext ?? "Não há contexto histórico publicado.")</p>
                <h3>Mandatos</h3>
                @foreach (var mandate in Item.Presidencies)
                {
                    <article class="card">
                        <h3>Período @mandate.Ordinal</h3>
                        <p>@mandate.StartDate.ToString("dd/MM/yyyy") – @(mandate.EndDate?.ToString("dd/MM/yyyy") ?? "em aberto")</p>
                        <p>Forma de chegada: @mandate.ArrivalMethod · Tipo de governo: @mandate.GovernmentType</p>
                        <p>Partido: @(mandate.Party ?? "não informado") · Vice: @(mandate.VicePresident ?? "não informado")</p>
                        @if (!string.IsNullOrWhiteSpace(mandate.PoliticalContext))
                        {
                            <p>@mandate.PoliticalContext</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(mandate.DivergenceNote))
                        {
                            <p class="banner">@mandate.DivergenceNote</p>
                        }
                        <Sources Items="mandate.Sources" />
                    </article>
                }
                @if (Item.Statements.Count > 0)
                {
                    <h3>Afirmações publicadas</h3>
                    @foreach (var statement in Item.Statements)
                    {
                        <article class="card">
                            <p><span class="kind @Ui.KindClass(statement.Kind)">@statement.Kind</span></p>
                            <p>@statement.Text</p>
                            @if (!string.IsNullOrWhiteSpace(statement.Attribution))
                            {
                                <p class="muted">Atribuição: @statement.Attribution</p>
                            }
                            <Sources Items="statement.Sources" />
                        </article>
                    }
                }
            </section>

            @foreach (var section in Item.Sections.Where(section => section.Events.Count > 0 || section.Policies.Count > 0))
            {
                <section id="@section.Slug">
                    <h2>@section.Name</h2>
                    @foreach (var ev in section.Events)
                    {
                        <FactCard Title="@ev.Title" Href="@($"/acontecimentos/{ev.Slug}")" Date="@ev.EventDate" Kind="@ev.SummaryKind" Summary="@(ev.NeutralSummary ?? ev.Description)" Divergence="@ev.DivergenceNote" Demonstration="@ev.Demonstration" Categories="@ev.Categories" Sources="@ev.Sources" />
                    }
                    @foreach (var policy in section.Policies)
                    {
                        <article class="card">
                            <h3><a href="@($"/politicas/{policy.Slug}")">@policy.Name</a></h3>
                            <p>@policy.Description</p>
                            <Sources Items="policy.Sources" />
                        </article>
                    }
                </section>
            }

            @if (Item.Events.Count > 0)
            {
                <section id="acontecimentos">
                    <h2>Acontecimentos</h2>
                    @foreach (var ev in Item.Events)
                    {
                        <FactCard Title="@ev.Title" Href="@($"/acontecimentos/{ev.Slug}")" Date="@ev.EventDate" Kind="@ev.SummaryKind" Summary="@(ev.NeutralSummary ?? ev.Description)" Divergence="@ev.DivergenceNote" Demonstration="@ev.Demonstration" Categories="@ev.Categories" Sources="@ev.Sources" />
                    }
                </section>
            }

            @if (Item.Indicators.Count > 0)
            {
                <h3>Valores anuais publicados</h3>
                <div class="table-wrap">
                    <table>
                        <caption>Valores publicados com fonte</caption>
                        <thead><tr><th>Indicador</th><th>Ano</th><th>Valor</th><th>Fonte</th></tr></thead>
                        <tbody>
                            @foreach (var point in Item.Indicators)
                            {
                                <tr>
                                    <td>@point.Indicator</td>
                                    <td>@point.Year</td>
                                    <td>@point.Value @point.Unit</td>
                                    <td>
                                        @if (point.Source?.Url is { Length: > 0 } url)
                                        {
                                            <a href="@url" rel="noopener noreferrer">@point.Source.Name</a>
                                        }
                                        else
                                        {
                                            @(point.Source?.Name ?? "Fonte não publicada")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Controversies.Count > 0 || ScandalEvents.Count > 0)
            {
            <section id="controversias">
                <h2>Controvérsias</h2>
                <p class="muted">Críticas, opiniões e interpretações aparecem com a origem da avaliação. Elas não são convertidas em fato.</p>
                @foreach (var statement in Controversies)
                {
                    <article class="card">
                        <p><span class="kind @Ui.KindClass(statement.Kind)">@statement.Kind</span></p>
                        <p>@statement.Text</p>
                        <p class="muted">Atribuição: @(statement.Attribution ?? "não informada")</p>
                        <Sources Items="statement.Sources" />
                    </article>
                }
                @foreach (var ev in ScandalEvents)
                {
                    <FactCard Title="@ev.Title" Href="@($"/acontecimentos/{ev.Slug}")" Date="@ev.EventDate" Kind="@ev.SummaryKind" Summary="@(ev.NeutralSummary ?? ev.Description)" Divergence="@ev.DivergenceNote" Demonstration="@ev.Demonstration" Categories="@ev.Categories" Sources="@ev.Sources" />
                }
            </section>
            }

            <section id="fontes">
                <h2>Fontes do registro</h2>
                @if (!string.IsNullOrWhiteSpace(Item.OfficialBiographyUrl))
                {
                    <p><a href="@Item.OfficialBiographyUrl" rel="noopener noreferrer">Biografia oficial cadastrada</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(Item.WikipediaUrl))
                {
                    <p><a href="@Item.WikipediaUrl" rel="noopener noreferrer">Página externa cadastrada</a></p>
                }
                <Sources Items="Item.Sources" Open="true" />
            </section>
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    private PresidentDetailDto? Item;
    private bool Missing;
    private string Meta => Item?.Biography ?? Item?.HistoricalContext ?? "Página de presidente com mandatos, fontes e registros publicados.";
    private string JsonLd => Item is null ? "" : Ui.Json(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = Item.FullName,
        ["url"] = Canonical,
        ["description"] = Meta,
        ["sameAs"] = Item.OfficialBiographyUrl
    });
    private string Canonical => (HttpContext.Request.Scheme + "://" + HttpContext.Request.Host) + $"/presidentes/{Slug}";
    private IReadOnlyList<StatementDto> Controversies => Item?.Statements.Where(item => item.KindCode is StatementKind.GroupCriticism or StatementKind.Opinion or StatementKind.HistoricalInterpretation or StatementKind.JournalisticInformation).ToList() ?? [];
    private IReadOnlyList<EventCardDto> ScandalEvents => Item?.Events.Where(item => item.EventType == "Escândalo").ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        Item = await Queries.PresidentAsync(Slug, HttpContext.RequestAborted);
        if (Item is null)
        {
            Missing = true;
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
