@page "/Error"

<Seo Title="Erro" Description="A solicitação não pôde ser concluída." Path="/Error" />
<section class="section">
    <div class="wrap">
        <h1>Não foi possível concluir a solicitação</h1>
        <p>O erro foi registrado. Nenhum detalhe interno é exibido nesta página.</p>
        @if (!string.IsNullOrWhiteSpace(RequestId))
        {
            <p>Identificador: <code>@RequestId</code></p>
        }
        <a class="button" href="/">Voltar ao início</a>
    </div>
</section>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }
    protected override void OnInitialized() => RequestId = System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
