@page "/admin/acontecimentos"
@page "/admin/acontecimentos/novo"
@page "/admin/acontecimentos/{Id:guid}"
@attribute [Authorize(Policy = "Editor")]
@layout AdminLayout
@inject EventService Events
@inject AdminCatalogService Catalog
@inject PresidentService Presidents
@inject CategoryService Categories
@inject PublicationService Publication
@inject NavigationManager Nav

<PageTitle>Acontecimentos</PageTitle>
<h1>Acontecimentos</h1>
@if (!string.IsNullOrWhiteSpace(Error)) { <p class="error" role="alert">@Error</p> }
@if (ShowForm)
{
    <p><a href="/admin/acontecimentos">Voltar à lista</a></p>
    <EditForm Model="Form" FormName="happening" OnSubmit="Save" method="post">
        <div class="form-grid">
            <label>Título <InputText @bind-Value="Form.Title" /></label>
            <label>Endereço <InputText @bind-Value="Form.Slug" /></label>
            <label>Presidente
                <InputSelect @bind-Value="Form.PresidentId">
                    <option value="">Não vincular</option>
                    @foreach (var president in Options) { <option value="@president.Id">@president.Name</option> }
                </InputSelect>
            </label>
            <label>Início <InputDate @bind-Value="Form.EventDate" /></label>
            <label>Fim <InputDate @bind-Value="Form.EndDate" /></label>
            <label>Tipo <EnumSelect T="EventType" @bind-Value="Form.EventType" /></label>
            <label>Importância <EnumSelect T="ImportanceLevel" @bind-Value="Form.Importance" /></label>
            <label>Natureza do resumo <EnumSelect T="StatementKind" @bind-Value="Form.SummaryKind" /></label>
            <label>Resumo <InputTextArea @bind-Value="Form.NeutralSummary" /></label>
            <label>Descrição <InputTextArea @bind-Value="Form.Description" /></label>
            <label>Divergência <InputTextArea @bind-Value="Form.DivergenceNote" /></label>
            <fieldset>
                <legend>Categorias</legend>
                <CategoryChecks FormName="happening" Categories="CategoryRows" Selected="Form.CategoryIds" />
            </fieldset>
            <button type="submit">Salvar</button>
        </div>
    </EditForm>
    <PublicationButtons Id="Id" Type="ContentEntityType.HistoricalEvent" Key="event-status" />
}
else
{
    <p><a class="button" href="/admin/acontecimentos/novo">Novo acontecimento</a></p>
    <AdminTable Caption="Acontecimentos" Rows="Rows" EditBase="/admin/acontecimentos" CanDelete="Actor.IsAdmin" OnCommand="Handle" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "happening")] public EventForm? Form { get; set; }
    private IReadOnlyList<AdminRow> Rows = [];
    private IReadOnlyList<AdminRow> CategoryRows = [];
    private IReadOnlyList<NamedOption> Options = [];
    private string? Error;
    private ActorContext Actor => Actors.From(HttpContext.User);
    private bool ShowForm => Id is not null || Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].EndsWith("/novo", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var posted = Form is not null;
        Form ??= new EventForm();
        var token = HttpContext.RequestAborted;
        if (ShowForm)
        {
            Options = await Presidents.OptionsAsync(false, Actor, token);
            CategoryRows = (await Categories.ListAdminAsync(Actor, token)).Items;
            if (!posted && Id is Guid id)
            {
                var loaded = await Events.GetFormAsync(id, Actor, token);
                if (loaded is null) Error = "Acontecimento não encontrado.";
                else Form = loaded;
            }
        }
        else Rows = await Catalog.EventsAsync(Actor, token);
    }

    private async Task Save()
    {
        try
        {
            Form!.Id = Id;
            var saved = await Events.SaveAsync(Form, Actor, HttpContext.RequestAborted);
            Nav.NavigateTo($"/admin/acontecimentos/{saved}", forceLoad: true);
        }
        catch (Exception exception) when (exception is ValidationException or DomainException or ForbiddenException or NotFoundException)
        {
            Error = Ui.Message(exception);
        }
    }

    private async Task Handle(string verb, Guid id)
    {
        var token = HttpContext.RequestAborted;
        if (verb == "delete") await Events.DeleteAsync(id, Actor, token);
        else if (AdminCommand.ToStatus(verb) is { } status) await Publication.ChangeEventAsync(id, status, Actor, token);
        Rows = await Catalog.EventsAsync(Actor, token);
    }
}
