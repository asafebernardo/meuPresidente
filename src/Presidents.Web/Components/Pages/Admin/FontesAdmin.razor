@page "/admin/fontes"
@page "/admin/fontes/novo"
@page "/admin/fontes/{Id:guid}"
@attribute [Authorize(Policy = "Editor")]
@layout AdminLayout
@inject SourceService Sources
@inject AdminCatalogService Catalog
@inject PublicationService Publication
@inject NavigationManager Nav

<PageTitle>Fontes</PageTitle>
<h1>Fontes</h1>
<p class="muted">Guarde título, URL, veículo, autoria e data. Não cole o artigo jornalístico integral.</p>
@if (!string.IsNullOrWhiteSpace(Error)) { <p class="error" role="alert">@Error</p> }
@if (ShowForm)
{
    <p><a href="/admin/fontes">Voltar à lista</a></p>
    <EditForm Model="Form" FormName="source" OnSubmit="Save" method="post">
        <div class="form-grid">
            <label>Nome <InputText @bind-Value="Form.Name" /></label>
            <label>Endereço <InputText @bind-Value="Form.Slug" /></label>
            <label>URL <InputText @bind-Value="Form.Url" /></label>
            <label>Tipo <EnumSelect T="SourceType" @bind-Value="Form.SourceType" /></label>
            <label>Confiabilidade <EnumSelect T="ReliabilityLevel" @bind-Value="Form.ReliabilityLevel" /></label>
            <label>Veículo <InputText @bind-Value="Form.Publisher" /></label>
            <label>Autor <InputText @bind-Value="Form.Author" /></label>
            <label>Título da obra <InputText @bind-Value="Form.Title" /></label>
            <label>Publicação <InputDate @bind-Value="Form.PublicationDate" /></label>
            <label>Acesso <InputDate @bind-Value="Form.AccessedAt" /></label>
            <label>Notas <InputTextArea @bind-Value="Form.Notes" /></label>
            <button type="submit">Salvar</button>
        </div>
    </EditForm>
    <PublicationButtons Id="Id" Type="ContentEntityType.Source" Key="source-status" />
}
else
{
    <p><a class="button" href="/admin/fontes/novo">Nova fonte</a></p>
    <AdminTable Caption="Fontes" Rows="Rows" EditBase="/admin/fontes" CanDelete="Actor.IsAdmin" OnCommand="Handle" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "source")] public SourceForm? Form { get; set; }
    private IReadOnlyList<AdminRow> Rows = [];
    private string? Error;
    private ActorContext Actor => Actors.From(HttpContext.User);
    private bool ShowForm => Id is not null || Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].EndsWith("/novo", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var posted = Form is not null;
        Form ??= new SourceForm();
        var token = HttpContext.RequestAborted;
        if (!posted && ShowForm && Id is Guid id)
        {
            var loaded = await Sources.GetFormAsync(id, Actor, token);
            if (loaded is null) Error = "Fonte não encontrada.";
            else Form = loaded;
        }
        else if (!ShowForm)
            Rows = await Catalog.SourcesAsync(Actor, token);
    }

    private async Task Save()
    {
        try
        {
            Form!.Id = Id;
            var saved = await Sources.SaveAsync(Form, Actor, HttpContext.RequestAborted);
            Nav.NavigateTo($"/admin/fontes/{saved}", forceLoad: true);
        }
        catch (Exception exception) when (exception is ValidationException or DomainException or ForbiddenException or NotFoundException)
        {
            Error = Ui.Message(exception);
        }
    }

    private async Task Handle(string verb, Guid id)
    {
        var token = HttpContext.RequestAborted;
        if (verb == "delete") await Sources.DeleteAsync(id, Actor, token);
        else if (AdminCommand.ToStatus(verb) is { } status) await Publication.ChangeSourceAsync(id, status, Actor, token);
        Rows = await Catalog.SourcesAsync(Actor, token);
    }
}
